# Supabase — get these from your project's Settings > API at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Image generation ────────────────────────────────────────────────────────
# Provider priority: Cloudflare Workers AI → Google Gemini → Pollinations (free)
#
# Option 1 (RECOMMENDED): Cloudflare Workers AI — free 100K neurons/day
#   1. Sign up at https://dash.cloudflare.com (free)
#   2. Go to Workers AI → Use REST API → Create API Token + copy Account ID
#   3. Set both variables below
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Option 2: Google Gemini — best quality, requires PAID billing
#   Free tier has ZERO quota for image generation models.
#   Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MODEL_PREMIUM=gemini-3-pro-image

# Option 3 (default): Pollinations — always works, no keys needed
#   Override model with POLLINATIONS_MODEL=flux-realism (or flux, flux-dev, turbo)
POLLINATIONS_MODEL=flux-dev
